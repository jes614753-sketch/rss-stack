# ===== 复制为 feishu.env 并填入真实值（机器人凭证与目标群，勿提交/勿外传）=====

# 机器人A：RSS 信息源（推送者）
FEISHU_APP_ID=cli_xxx
FEISHU_APP_SECRET=xxx

# 推送目标群
FEISHU_CHAT_ID=oc_xxx

# Miniflux（relay 与脚本读取用）
MINIFLUX_URL=http://miniflux:8080
# 宿主机脚本用（容器内脚本用上面的 MINIFLUX_URL）
MINIFLUX_URL_HOST=http://127.0.0.1:8088
MINIFLUX_ADMIN_USERNAME=admin
MINIFLUX_ADMIN_PASSWORD=change-me-16chars

# ===== 日报点名（备用通道：群内 @ / 文本）=====
# 留空 = 取消自动点名；填用户 open_id（智能体以此身份工作）则私聊触发
REPORT_BOT_NAME=
REPORT_BOT_OPEN_ID=
REPORT_TRIGGER_COOLDOWN_H=20

# ===== 首选触发：以用户身份私聊智能体 =====
# 填智能体机器人的 open_id（本应用命名空间，bot/v3/info 获取）
REPORT_DM_TARGET=ou_xxx

# ===== 总览源（跳过增量卡片，场次出总览卡）=====
SKIP_FEED_IDS=9,10
OVERVIEW_FEED_IDS=9,10

# ===== Follow Builders 转换桥 =====
FOLLOW_BUILDERS=1
FB_PROXY=http://host.docker.internal:7891

# ===== 飞书文档归档 =====
ARCHIVE_FOLDER_TOKEN=xxxx
